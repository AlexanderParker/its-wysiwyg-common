{
  "name": "its-template-editor",
  "version": "0.10.1",
  "description": "WYSIWYG React editor component for Instruction Template Specification (ITS) templates",
  "license": "MIT",
  "author": "Alexander Parker",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexanderParker/its-wysiwyg-common.git"
  },
  "homepage": "https://github.com/AlexanderParker/its-wysiwyg-common#readme",
  "bugs": {
    "url": "https://github.com/AlexanderParker/its-wysiwyg-common/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "its",
    "instruction-template-specification",
    "template",
    "editor",
    "react",
    "wysiwyg",
    "prompt",
    "ai"
  ]
}
